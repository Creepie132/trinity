{
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "src/app/api/products/upload-image/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/kira/cron/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/birthdays",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/birthday-tasks",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/archive-tasks",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/push-dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/push-events",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/kira/cron",
      "schedule": "30 6 * * *"
    }
  ]
}
