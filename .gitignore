# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# internal trash — never commit (contains legacy/dangerous files)
src/lib/_trash/
src/app/api/_trash/

# dependencies
/node_modules
.next
.env.local
.env*.local
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
build.log

_git_push.js

# temp files from Claude tooling - never commit these
__cm.txt
__commitmsg.txt
__commit_out.txt
__grep_out.txt
deploy.bat
queryClient.invalidateQueries*
build_out.txt

# APK releases — stored in Vercel Blob, not in git
public/releases/

# next-pwa generated files — генерируются при каждом build, не коммитить
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map

# Служебные файлы Claude (Desktop Commander)
docs/_deploy.ps1
docs/_git_result.txt
docs/_git_out.txt
