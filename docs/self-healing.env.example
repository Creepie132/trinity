# ─── Self-Healing System ─────────────────────────────────────────────────────
# Добавить в .env.local и в Vercel Environment Variables (Production + Preview)

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# GitHub API (Personal Access Token с правами: repo, contents, pull_requests)
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=Creepie132
GITHUB_REPO=trinity

# Vercel API (Token из vercel.com/account/tokens)
VERCEL_TOKEN=...
VERCEL_PROJECT_ID=prj_...         # из настроек проекта Vercel
VERCEL_TEAM_ID=team_...           # оставить пустым если без team

# Telegram (чат ID администратора, получить через @userinfobot)
TELEGRAM_BOT_TOKEN=...            # уже есть в проекте
TELEGRAM_ADMIN_CHAT_ID=...        # твой личный chat_id

# Симулятор краш-тестов (секрет для запуска в продакшн без dev-режима)
SIMULATE_CRASH_SECRET=super-secret-crash-token-change-me
